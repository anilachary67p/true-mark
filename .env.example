# TrueMark — Environment Configuration
# Copy to .env and adjust. DO NOT commit .env to version control.

DATABASE_URL=postgresql://truemark:truemark_dev@localhost:5432/truemark?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
AUTH_MODE=dev
JWT_SECRET=change-me-to-at-least-32-random-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_PROVIDER=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=truemark
MINIO_USE_SSL=false
AI_PROVIDER=mock
ADMIN_WEB_URL=http://localhost:3000
CONSUMER_WEB_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VERIFY_HOSTNAME=verify.localhost
RATE_LIMIT_VERIFY_PER_MIN=60
RATE_LIMIT_AI_PER_MIN=10
# Do NOT set NODE_ENV here for local dev.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform & Tenant ───────────────────────────────────────────────────────

model Tenant {
  id              String         @id @default(uuid())
  name            String
  legalName       String?        @map("legal_name")
  status          TenantStatus   @default(PENDING)
  deploymentType  DeploymentType @default(SAAS) @map("deployment_type")
  configVersion   Int            @default(1) @map("config_version")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  profile              TenantProfile?
  companyDomains       CompanyDomain[]
  verificationDomains  VerificationDomain[]
  users                UserTenantRole[]
  manufacturers        Manufacturer[]
  fraudConfig          FraudConfig?
  aiConfig             AiConfig?
  qrCustomizationConfigs QrCustomizationConfig[]
  verificationEvents   VerificationEvent[]
  investigations       Investigation[]
  consumerReports      ConsumerReport[]
  auditLogs            AuditLog[]
  analyticsDaily       AnalyticsDaily[]
  bulkJobs             BulkJob[]

  @@map("tenants")
}

model TenantProfile {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  address   String?
  country   String?
  contactEmail String? @map("contact_email")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum DeploymentType {
  SAAS
  DEDICATED_CLOUD
  CUSTOMER_CLOUD
  ON_PREM
  HYBRID
}

// ─── Domains ─────────────────────────────────────────────────────────────────

model CompanyDomain {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  url       String
  status    DomainStatus @default(PENDING)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, url])
  @@index([tenantId])
  @@map("company_domains")
}

model VerificationDomain {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  hostname         String       @unique
  verificationPath String       @default("/v") @map("verification_path")
  status           DomainStatus @default(PENDING)
  version          Int          @default(1)
  isPrimary        Boolean      @default(false) @map("is_primary")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  challenges   DomainVerificationChallenge[]
  verificationEvents VerificationEvent[]

  @@index([tenantId])
  @@index([hostname, status])
  @@map("verification_domains")
}

model DomainVerificationChallenge {
  id                   String    @id @default(uuid())
  verificationDomainId String    @map("verification_domain_id")
  txtRecord            String    @map("txt_record")
  verifiedAt           DateTime? @map("verified_at")
  expiresAt            DateTime  @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  verificationDomain VerificationDomain @relation(fields: [verificationDomainId], references: [id], onDelete: Cascade)

  @@map("domain_verification_challenges")
}

enum DomainStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  DISABLED
}

// ─── Auth & RBAC ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  oidcSub      String?  @unique @map("oidc_sub")
  name         String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenantRoles       UserTenantRole[]
  auditLogs         AuditLog[]
  investigations    Investigation[] @relation("Investigator")
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserTenantRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String?  @map("tenant_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, role])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant_roles")
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  MANUFACTURER_ADMIN
  PRODUCT_MANAGER
  FRAUD_INVESTIGATOR
  ANALYST
  READ_ONLY
}

// ─── Product Hierarchy ─────────────────────────────────────────────────────────

model Manufacturer {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  name      String
  status    LifecycleStatus @default(ACTIVE)
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brands Brand[]

  @@index([tenantId])
  @@map("manufacturers")
}

model Brand {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  manufacturerId String          @map("manufacturer_id")
  name           String
  status         LifecycleStatus @default(ACTIVE)
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([tenantId])
  @@index([manufacturerId])
  @@map("brands")
}

model Product {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  brandId   String          @map("brand_id")
  name      String
  sku       String?
  status    LifecycleStatus @default(DRAFT)
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  brand    Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([tenantId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  productId String          @map("product_id")
  name      String
  status    LifecycleStatus @default(DRAFT)
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model Batch {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  productVariantId String          @map("product_variant_id")
  batchCode        String          @map("batch_code")
  status           LifecycleStatus @default(DRAFT)
  manufacturingDate DateTime?      @map("manufacturing_date")
  expiryDate       DateTime?       @map("expiry_date")
  metadata         Json            @default("{}")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productUnits   ProductUnit[]
  bulkJobs       BulkJob[]

  @@unique([tenantId, batchCode])
  @@index([tenantId])
  @@map("batches")
}

model ProductUnit {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  batchId   String          @map("batch_id")
  status    LifecycleStatus @default(REGISTERED)
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  batch                Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  serial               Serial?
  verificationCredential VerificationCredential?
  qrCode               QrCode?
  verificationEvents   VerificationEvent[]

  @@index([tenantId])
  @@index([batchId])
  @@map("product_units")
}

model Serial {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  productUnitId String   @unique @map("product_unit_id")
  serialNumber  String   @map("serial_number")
  createdAt     DateTime @default(now()) @map("created_at")

  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@map("serials")
}

model VerificationCredential {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  productUnitId String          @unique @map("product_unit_id")
  tokenHash     String          @map("token_hash")
  tokenPrefix   String          @map("token_prefix")
  status        LifecycleStatus @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)

  @@index([tenantId, tokenHash])
  @@index([tokenPrefix])
  @@map("verification_credentials")
}

enum LifecycleStatus {
  DRAFT
  REGISTERED
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  REVOKED
  RECALLED
  DISCONTINUED
  RETIRED
}

// ─── QR System ─────────────────────────────────────────────────────────────────

model QrCode {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  productUnitId String          @unique @map("product_unit_id")
  token         String          @unique
  url           String
  status        LifecycleStatus @default(ACTIVE)
  configVersion Int             @default(1) @map("config_version")
  domainVersion Int             @default(1) @map("domain_version")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  productUnit        ProductUnit         @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  lifecycleEvents    QrLifecycleEvent[]
  verificationEvents VerificationEvent[]

  @@index([tenantId])
  @@index([token])
  @@map("qr_codes")
}

model QrLifecycleEvent {
  id        String          @id @default(uuid())
  qrCodeId  String          @map("qr_code_id")
  status    LifecycleStatus
  reason    String?
  createdAt DateTime        @default(now()) @map("created_at")

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_lifecycle_events")
}

model QrCustomizationConfig {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  scope     String   @default("tenant")
  scopeId   String?  @map("scope_id")
  version   Int      @default(1)
  config    Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, scopeId])
  @@map("qr_customization_configs")
}

// ─── Verification ──────────────────────────────────────────────────────────────

model VerificationEvent {
  id                   String             @id @default(uuid())
  publicId             String             @unique @default(uuid()) @map("public_id")
  tenantId             String             @map("tenant_id")
  productUnitId        String?            @map("product_unit_id")
  qrCodeId             String?            @map("qr_code_id")
  verificationDomainId String?            @map("verification_domain_id")
  method               VerificationMethod
  result               VerificationResult
  riskLevel            String?            @map("risk_level")
  correlationId        String             @map("correlation_id")
  domainConfigVersion  Int?               @map("domain_config_version")
  productSnapshot      Json?              @map("product_snapshot")
  ipAddress            String?            @map("ip_address")
  userAgent            String?            @map("user_agent")
  createdAt            DateTime           @default(now()) @map("created_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  productUnit        ProductUnit?        @relation(fields: [productUnitId], references: [id])
  qrCode             QrCode?             @relation(fields: [qrCodeId], references: [id])
  verificationDomain VerificationDomain? @relation(fields: [verificationDomainId], references: [id])
  location           VerificationLocation?
  fraudSignals       FraudSignal[]
  aiJobs             AiJob[]
  consumerReports    ConsumerReport[]

  @@index([tenantId, createdAt])
  @@index([productUnitId, createdAt])
  @@index([correlationId])
  @@map("verification_events")
}

model VerificationLocation {
  id                  String         @id @default(uuid())
  verificationEventId String         @unique @map("verification_event_id")
  country             String?
  region              String?
  city                String?
  latitude            Float?
  longitude           Float?
  source              LocationSource @default(UNKNOWN)
  createdAt           DateTime       @default(now()) @map("created_at")

  verificationEvent VerificationEvent @relation(fields: [verificationEventId], references: [id], onDelete: Cascade)

  @@map("verification_locations")
}

enum VerificationMethod {
  QR_SCAN
  MANUAL_CODE
}

enum VerificationResult {
  VERIFIED
  REVERIFIED
  SUSPICIOUS
  POSSIBLE_CLONE
  POSSIBLE_COUNTERFEIT
  CONFIRMED_COUNTERFEIT
  INVALID_QR
  UNKNOWN_QR
  REVOKED_QR
  BLOCKED_QR
  EXPIRED
  RECALLED
  SUSPENDED
  UNABLE_TO_VERIFY
}

enum LocationSource {
  GPS
  IP
  NETWORK
  MANUAL
  UNKNOWN
}

// ─── Fraud ─────────────────────────────────────────────────────────────────────

model FraudConfig {
  id                      String @id @default(uuid())
  tenantId                String @unique @map("tenant_id")
  highScanCount           Int    @default(50) @map("high_scan_count")
  highScanWindowMinutes   Int    @default(30) @map("high_scan_window_minutes")
  maxTravelSpeedKmh       Float  @default(900) @map("max_travel_speed_kmh")
  impossibleTravelMinutes Int    @default(60) @map("impossible_travel_minutes")
  config                  Json   @default("{}")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("fraud_configs")
}

model FraudSignal {
  id                  String          @id @default(uuid())
  verificationEventId String          @map("verification_event_id")
  signalType          FraudSignalType @map("signal_type")
  severity            String          @default("MEDIUM")
  evidence            Json            @default("{}")
  createdAt           DateTime        @default(now()) @map("created_at")

  verificationEvent VerificationEvent @relation(fields: [verificationEventId], references: [id], onDelete: Cascade)

  @@index([verificationEventId])
  @@map("fraud_signals")
}

enum FraudSignalType {
  HIGH_SCAN_FREQUENCY
  GEOGRAPHIC_ANOMALY
  IMPOSSIBLE_TRAVEL
  EXCESSIVE_QR_REUSE
  SERIAL_REUSE
  AI_PHYSICAL_MISMATCH
  PACKAGING_MISMATCH
  CONSUMER_REPORT
}

model Investigation {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  title       String
  status      InvestigationStatus @default(OPEN)
  description String?
  evidence    Json                @default("{}")
  investigatorId String?          @map("investigator_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  investigator User?                 @relation("Investigator", fields: [investigatorId], references: [id])
  events       InvestigationEvent[]

  @@index([tenantId, status])
  @@map("investigations")
}

model InvestigationEvent {
  id              String              @id @default(uuid())
  investigationId String              @map("investigation_id")
  status          InvestigationStatus
  note            String?
  createdAt       DateTime            @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@map("investigation_events")
}

enum InvestigationStatus {
  OPEN
  UNDER_REVIEW
  FALSE_POSITIVE
  CONFIRMED_COUNTERFEIT
  RESOLVED
}

model ConsumerReport {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  verificationEventId String?  @map("verification_event_id")
  reason              String
  comment             String?
  ipAddress           String?  @map("ip_address")
  createdAt           DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  verificationEvent VerificationEvent? @relation(fields: [verificationEventId], references: [id])

  @@index([tenantId])
  @@map("consumer_reports")
}

// ─── AI ────────────────────────────────────────────────────────────────────────

model AiConfig {
  id        String  @id @default(uuid())
  tenantId  String  @unique @map("tenant_id")
  mode      AiMode  @default(AI_DISABLED)
  quota     Int     @default(1000)
  config    Json    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referenceData AiReferenceData[]

  @@map("ai_configs")
}

model AiReferenceData {
  id         String   @id @default(uuid())
  aiConfigId String   @map("ai_config_id")
  tenantId   String   @map("tenant_id")
  scope      String   @default("product")
  scopeId    String?  @map("scope_id")
  version    Int      @default(1)
  objectKey  String   @map("object_key")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  aiConfig AiConfig @relation(fields: [aiConfigId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, scopeId])
  @@map("ai_reference_data")
}

model AiJob {
  id                  String      @id @default(uuid())
  verificationEventId String      @map("verification_event_id")
  status              AiJobStatus @default(PENDING)
  provider            String?
  model               String?
  modelVersion        String?     @map("model_version")
  configVersion       Int?        @map("config_version")
  confidence          Float?
  result              Json?
  errorMessage        String?     @map("error_message")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  completedAt         DateTime?   @map("completed_at")

  verificationEvent VerificationEvent @relation(fields: [verificationEventId], references: [id], onDelete: Cascade)
  images            AiImage[]
  ocrResults        AiOcrResult[]
  fieldMismatches   AiFieldMismatch[]
  visualResults     AiVisualResult[]

  @@index([verificationEventId])
  @@map("ai_jobs")
}

model AiImage {
  id        String         @id @default(uuid())
  aiJobId   String         @map("ai_job_id")
  viewAngle ImageViewAngle @map("view_angle")
  objectKey String         @map("object_key")
  quality   Json           @default("{}")
  createdAt DateTime       @default(now()) @map("created_at")

  aiJob AiJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@map("ai_images")
}

model AiOcrResult {
  id         String   @id @default(uuid())
  aiJobId    String   @map("ai_job_id")
  fieldName  String   @map("field_name")
  extracted  String
  expected   String?
  isMatch    Boolean  @map("is_match")
  confidence Float?
  createdAt  DateTime @default(now()) @map("created_at")

  aiJob AiJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@map("ai_ocr_results")
}

model AiFieldMismatch {
  id         String   @id @default(uuid())
  aiJobId    String   @map("ai_job_id")
  fieldName  String   @map("field_name")
  expected   String
  actual     String
  createdAt  DateTime @default(now()) @map("created_at")

  aiJob AiJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@map("ai_field_mismatches")
}

model AiVisualResult {
  id         String   @id @default(uuid())
  aiJobId    String   @map("ai_job_id")
  checkType  String   @map("check_type")
  passed     Boolean
  confidence Float?
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  aiJob AiJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@map("ai_visual_results")
}

enum AiMode {
  AI_DISABLED
  AI_OPTIONAL
  AI_REQUIRED
}

enum AiJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  IMAGE_NOT_CLEAR
  AI_NOT_CONFIGURED
  AI_UNAVAILABLE
}

enum ImageViewAngle {
  FRONT
  BACK
  LEFT
  RIGHT
  TOP
  BOTTOM
  ADDITIONAL
}

// ─── Analytics ─────────────────────────────────────────────────────────────────

model AnalyticsDaily {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  date      DateTime @db.Date
  metrics   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("analytics_daily")
}

// ─── Jobs ──────────────────────────────────────────────────────────────────────

model BulkJob {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  batchId     String        @map("batch_id")
  quantity    Int
  processed   Int           @default(0)
  status      BulkJobStatus @default(PENDING)
  errorMessage String?      @map("error_message")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  completedAt DateTime?     @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  batch  Batch  @relation(fields: [batchId], references: [id])

  @@index([tenantId, status])
  @@map("bulk_jobs")
}

enum BulkJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  before       Json?
  after        Json?
  correlationId String? @map("correlation_id")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

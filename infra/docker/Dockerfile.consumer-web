FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS builder
COPY . .
RUN pnpm install && pnpm --filter @truemark/shared build && pnpm --filter @truemark/consumer-web build

FROM node:22-alpine AS runner
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 truemark
WORKDIR /app
USER truemark
COPY --from=builder --chown=truemark:nodejs /app/apps/consumer-web/.next/standalone ./
COPY --from=builder --chown=truemark:nodejs /app/apps/consumer-web/.next/static ./apps/consumer-web/.next/static
COPY --from=builder --chown=truemark:nodejs /app/apps/consumer-web/public ./apps/consumer-web/public
EXPOSE 3002
ENV PORT=3002
CMD ["node", "apps/consumer-web/server.js"]
